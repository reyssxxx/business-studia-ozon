# Бесплатный режим: открытые модели на Hugging Face (IDM-VTON, Leffa).
# Токен: https://huggingface.co/settings/tokens (тип Read). Без него квота GPU почти нулевая.
HF_TOKEN=

# Платный режим: FASHN на fal.ai (https://fal.ai/dashboard/keys). Если задан, используется он.
FAL_KEY=

# Бесплатный запасной провайдер Pollinations: включается сам, когда у Hugging Face кончился лимит.
# Ключ: https://enter.pollinations.ai/keys
POLLINATIONS_KEY=

# Принудительно выбрать провайдера: hf | fal | pollinations | mock
TRYON_PROVIDER=

# Необязательно: код доступа, чтобы чужие по QR не тратили генерации
DEMO_ACCESS_CODE=
# Лимит генераций в сутки на инстанс
MAX_GENERATIONS_PER_DAY=300
# Лимит генераций в час с одного адреса
MAX_GENERATIONS_PER_HOUR_PER_IP=40

# Низ и платья: Leffa первой (лучшее качество), IDM-VTON со своей маской как запасная. HF_LOWER_MODEL=idm меняет порядок.
HF_LOWER_MODEL=
# Своя копия Leffa (Space на платном GPU или адрес вашего сервера), чтобы не зависеть от квоты ZeroGPU
LEFFA_SPACE=

# Gemini и другие модели картинок через OpenRouter (оплата в USDC): https://openrouter.ai/settings/keys
OPENROUTER_KEY=

# ---------- Платный режим (Gemini) и пул ключей ----------
# Списки через запятую: при исчерпании лимита сервер сам берёт следующий ключ.
# Ключи только ваши: свои счета OpenRouter, токены Hugging Face одногруппников со своих аккаунтов.
OPENROUTER_KEYS=
HF_TOKENS=
POLLINATIONS_KEYS=
# Модели по порядку: основная, запасная
OPENROUTER_MODELS=google/gemini-nano-banana-2.1,google/gemini-3.1-flash-lite-image
# Пароль, который включает платный режим на сайте, и секрет подписи токенов (случайная строка 32+ символа)
PAID_PASSWORD=
AUTH_SECRET=
# Сколько часов действует доступ после ввода пароля
PAID_TTL_HOURS=12
# Аварийный выключатель: false отключает платный режим для всех
PAID_ENABLED=true
# Мягкие лимиты (в памяти копии функции). Жёсткий лимит ставьте на самом ключе OpenRouter.
PAID_DAILY_BUDGET_USD=3
PAID_MAX_PER_HOUR=30
